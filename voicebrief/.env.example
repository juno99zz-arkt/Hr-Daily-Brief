# ══════════════════════════════════════════════════════════════════════════
# VoiceBrief 환경 변수 — 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
# ══════════════════════════════════════════════════════════════════════════

# ── 서버 ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# 콤마 구분. 프론트를 별도 도메인에 배포하면 그 도메인을 넣으세요.
CORS_ORIGINS=*
MAX_UPLOAD_MB=200
# 값을 넣으면 모든 API가 Bearer 토큰을 요구합니다(공개 배포 시 반드시 설정).
API_TOKEN=

# ── STT: Naver CLOVA Speech ──────────────────────────────────────────────
# 네이버 클라우드 플랫폼 > AI Services > CLOVA Speech > 도메인 생성 후 발급
#   - API Key   : 도메인 상세의 "Secret Key"
#   - Invoke URL: 예) https://clovaspeech-gw.ncloud.com/external/v1/1234/abcdef...
CLOVA_SPEECH_API_KEY=
CLOVA_SPEECH_INVOKE_URL=
CLOVA_LANGUAGE=ko-KR
CLOVA_DIARIZATION=1          # 화자 분리 사용
CLOVA_SPEAKER_MIN=1
CLOVA_SPEAKER_MAX=6
CLOVA_TIMEOUT_SEC=900        # 1시간 녹음도 sync로 받기 위해 넉넉히

# ── LLM: anthropic | openai ──────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SEC=240

# ── 메일: smtp | resend ──────────────────────────────────────────────────
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
# Gmail은 일반 비밀번호가 아니라 "앱 비밀번호"(16자리)를 사용해야 합니다.
# https://myaccount.google.com/apppasswords
SMTP_PASS=
SMTP_USE_TLS=1
MAIL_FROM=your-address@gmail.com
# 요약 보고서 수신 주소 (콤마 구분)
MAIL_TO=junoh.jung@samsung.com,juno99zz@naver.com
# MAIL_PROVIDER=resend 일 때만 사용
RESEND_API_KEY=

# ── 메신저: Telegram ─────────────────────────────────────────────────────
# 1) 텔레그램에서 @BotFather 검색 → /newbot → 토큰 발급
# 2) 만든 봇과 대화창을 열고 /start 전송
# 3) 서버 실행 후 GET /api/config/telegram-chat-id 호출하면 chat_id를 알려줍니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 메신저: 카카오톡 나에게 보내기 (선택) ────────────────────────────────
# 카카오 개발자센터 앱 생성 → 카카오 로그인 활성화 → talk_message 동의항목 →
# access token 발급(유효기간 6시간, 장기 사용 시 refresh 필요)
KAKAO_ENABLED=0
KAKAO_ACCESS_TOKEN=

# ── 기타 ─────────────────────────────────────────────────────────────────
KEEP_AUDIO=1                 # 0이면 처리 후 오디오 원본 삭제
FFMPEG_BIN=ffmpeg            # webm→mp3 변환에 필요 (brew/apt로 설치)
